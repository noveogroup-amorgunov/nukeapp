{
  "name": "nukeapp",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "saaaaaaaaasha",
    "url": "https://github.com/noveogroup-amorgunov"
  },
  "scripts": {
    "test:env": "./.scripts/validateEnv.sh",
    "prestart": "npm run test:env",
    "preinstall": "npx only-allow pnpm",
    "start": "vite",
    "preview": "vite preview",
    "build": "npm run test:env && tsc && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "build:storybook": "storybook build",
    "storybook": "storybook dev",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:eslint": "eslint .",
    "lint:types": "tsc --noEmit",
    "lint:steiger": "steiger src",
    "lint:dependency-cruiser": "depcruise src",
    "depcruise": "depcruise src --include-only '^src' --output-type dot | dot -T svg > dependency-graph.svg"
  },
  "dependencies": {
    "@ebay/nice-modal-react": "1.2.13",
    "@hookform/resolvers": "5.9.1",
    "@mswjs/data": "github:noveogroup-amorgunov/mswjs-data#feat-persist",
    "@reduxjs/toolkit": "2.12.0",
    "classnames": "2.5.1",
    "jose": "6.2.10",
    "msw": "2.15.0",
    "rc-dropdown": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.3",
    "redux-remember": "^6.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "5.18.7",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/builder-vite": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "dependency-cruiser": "18.2.0",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "17.12.0",
    "lint-staged": "17.4.1",
    "postcss": "8.5.26",
    "postcss-custom-media": "12.0.1",
    "postcss-import": "16.1.0",
    "postcss-mixins": "12.1.2",
    "postcss-nested": "7.0.2",
    "rollup-plugin-visualizer": "7.1.1",
    "simple-git-hooks": "2.14.0",
    "steiger": "0.6.0",
    "storybook": "10.5.10",
    "storybook-addon-remix-react-router": "^7.0.0",
    "ts-to-zod": "5.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.2.2",
    "vite-plugin-svgr": "5.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
